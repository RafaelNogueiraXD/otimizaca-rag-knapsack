# Copie para .env e preencha. O .env não vai para o git.
OPENAI_API_KEY=

# LLMs (Responses API). gpt-6-luna: US$ 0,10 / 1M tokens de entrada e US$ 0,50 / 1M de saída.
MODELO_GERADOR=gpt-6-luna
MODELO_JUIZ=gpt-6-luna
# reasoning_effort: none | low | medium | high | xhigh | max
ESFORCO_GERADOR=medium
ESFORCO_JUIZ=low

# Embeddings: openai (text-embedding-3-small) ou fastembed (local, sem custo e sem chave)
EMBEDDER=openai
# MODELO_EMBEDDING=text-embedding-3-small

# Seleção
TOP_K=4
ORCAMENTO_TOKENS=512

# Preços (US$ por 1M de tokens), usados para estimar o custo. Os do juiz valem os do gerador
# se não forem definidos.
PRECO_ENTRADA_MTOK=0.10
PRECO_SAIDA_MTOK=0.50
# PRECO_ENTRADA_JUIZ_MTOK=0.10
# PRECO_SAIDA_JUIZ_MTOK=0.50
